{
    "meta": {
        "language": "english",
        "languageShort": "en",
        "locale": "en-US",
        "version": "1.0.0",
        "contributors": [
            "Nicolas Morawietz"
        ],
        "autoFillVariables": {
            "memberName": {
                "description": "Name of a Member",
                "mock": "Nixkuchen"
            },
            "memberUserName": {
                "description": "Name of a Member",
                "mock": "Nixkuchen"
            },
            "memberNickname": {
                "description": "Name of a Member",
                "mock": "Nixkuchen"
            }
        }
    },
    "global": {
        "__type__": "collection"
    },
    "interaction": {},
    "command": {
        "__type__": "collection",
        "contributor": {
            "__type__": "collection",
            "infoMessage": {
                "__variables__": {
                    "neededPullRequests": {
                        "description": "Pull request to fullfill the open contributor role",
                        "mock": "30"
                    },
                    "neededCommits": {
                        "description": "Commits to fullfill the open contributor role",
                        "mock": "30"
                    }
                },
                "__type__": "discordEmbed",
                "title": "How to become an Open Contributor",
                "description": "To be an Open Contributor, meet these criteria:\n\n1. Have {neededCommits} or more commits.\n2. Have {neededPullRequests} or more pull requests.\n\nYou can check or get the role by using `/open-contributer` command."
            }
        },
        "open-contributor": {
            "__type__": "collection",
            "texts": {
                "__type__": "collection",
                "repo": {
                    "__type__": "string",
                    "string": "Repo"
                },
                "commits": {
                    "__type__": "string",
                    "string": "Commits"
                },
                "prs": {
                    "__type__": "string",
                    "string": "PRs"
                },
                "buttonLink": {
                    "__type__": "string",
                    "string": "Github OAuth Link"
                }
            },
            "errors": {
                "__type__": "collection",
                "timeout": {
                    "__type__": "discordEmbed",
                    "title": "Code expired",
                    "description": "This code is expired. Use /open-contributor to get a new one."
                },
                "similarInquiry": {
                    "__type__": "discordEmbed",
                    "title": "Request canceled",
                    "description": "It appears that a similar inquiry or request has already been submitted elsewhere, as a result, the current request has been canceled."
                },
                "roleAlreadyAdded": {
                    "__type__": "discordEmbed",
                    "title": "Well... you are an Open Contributor",
                    "description": "There is no need to use this command."
                }
            },
            "initialMessage": {
                "__type__": "discordEmbed",
                "title": "How to become an Open Contributor",
                "description": "For becoming an Open Contributor and its roles you must fulfill the following things:\n\n1. Have {neededCommits} or more commits\n2. Have {neededPr} or more pull requests\n\nClick the link button and check if you can become an Open Contributor.",
                "__variables__": {
                    "neededPr": {
                        "description": "The Pull request the user needs",
                        "mock": "10"
                    },
                    "neededCommits": {
                        "description": "The Commits a user needs",
                        "mock": "10"
                    }
                }
            },
            "results": {
                "__type__": "collection",
                "complete": {
                    "title": "Github Results",
                    "description": "Account: `{githubname}`\n\n{pbpr}\nYou got {yourpr} of {neededpr} pull requests.\n\n{pbcm}\nYou got {yourcommits} of {neededcommits} commits.\n\n{tablestring}\n\nWe have added you to our Open Contributor",
                    "__variables__": {
                        "githubname": {
                            "description": "githubname",
                            "mock": "Nicuschgifthub"
                        },
                        "pbpr": {
                            "description": "progress bar pull requests",
                            "mock": "[#####0000]"
                        },
                        "yourpr": {
                            "description": "your pull requests",
                            "mock": "1"
                        },
                        "neededpr": {
                            "description": "the pull request you need",
                            "mock": "10"
                        },
                        "pbcm": {
                            "description": "progress bar commits",
                            "mock": "[#####0000]"
                        },
                        "yourcommits": {
                            "description": "your current commits",
                            "mock": "1"
                        },
                        "neededcommits": {
                            "description": "commits a user needs",
                            "mock": "10"
                        },
                        "tablestring": {
                            "description": "table string of github results",
                            "mock": "[this is a table]"
                        }
                    }
                },
                "missingPullOrCommits": {
                    "__type__": "discordEmbed",
                    "title": "Github Results",
                    "description": "Account: `{githubname}`\n\n{pbpr}\nYou got {yourpr} of {neededpr} pull requests.\n\n{pbcm}\nYou got {yourcommits} of {neededcommits} commits.\n\n{tablestring}\n\nFulfill all requirements to become an Open Contributor.",
                    "__variables__": {
                        "githubname": {
                            "description": "githubname",
                            "mock": "Nicuschgifthub"
                        },
                        "pbpr": {
                            "description": "progress bar pull requests",
                            "mock": "[#####0000]"
                        },
                        "yourpr": {
                            "description": "your pull requests",
                            "mock": "1"
                        },
                        "neededpr": {
                            "description": "the pull request you need",
                            "mock": "10"
                        },
                        "pbcm": {
                            "description": "progress bar commits",
                            "mock": "[#####0000]"
                        },
                        "yourcommits": {
                            "description": "your current commits",
                            "mock": "1"
                        },
                        "neededcommits": {
                            "description": "commits a user needs",
                            "mock": "10"
                        },
                        "tablestring": {
                            "description": "table string of github results",
                            "mock": "[this is a table]"
                        }
                    }
                },
                "noData": {
                    "__type__": "discordEmbed",
                    "title": "Github Results for {githubname}",
                    "description": "You got no commits nor pull request's.",
                    "__variables__": {
                        "githubname": {
                            "description": "Name of the user",
                            "mock": "Nicuschgifthub"
                        }
                    }
                }
            }
        },
        "mydata": {
            "__type__": "collection",
            "infoMessage": {
                "__type__": "discordEmbed",
                "title": "We got your Data",
                "description": "This JSON file contains all the information we have saved about `you` in our DB."
            }
        },
        "rank": {
            "__type__": "collection",
            "ownRank": {
                "__type__": "discordEmbed",
                "title": "Level: {level}",
                "description": "{progressbar} [{xp} xp|{neededXp} xp]\n\nYou <@{rankuserid}> are currently on the {position} place.\nEarn XP by interacting on this server with others.",
                "__variables__": {
                    "level": {
                        "description": "level",
                        "mock": "12"
                    },
                    "progressbar": {
                        "description": "progressbar",
                        "mock": "[####000]"
                    },
                    "xp": {
                        "description": "xp you have",
                        "mock": "200"
                    },
                    "neededXp": {
                        "description": "xp you need",
                        "mock": "300"
                    },
                    "rankuserid": {
                        "description": "rank user id",
                        "mock": "366173301"
                    },
                    "position": {
                        "description": "position / place",
                        "mock": "4"
                    }
                }
            },
            "otherRank": {
                "__type__": "discordEmbed",
                "title": "Level: {level}",
                "description": "{progressbar} [{xp} xp|{neededXp} xp]\n\nCurrently <@{rankuserid}> is on the {position} place.",
                "__variables__": {
                    "level": {
                        "description": "level",
                        "mock": "12"
                    },
                    "progressbar": {
                        "description": "progressbar",
                        "mock": "[####000]"
                    },
                    "xp": {
                        "description": "other xp",
                        "mock": "200"
                    },
                    "neededXp": {
                        "description": "other xp for next level",
                        "mock": "300"
                    },
                    "rankuserid": {
                        "description": "rank user id",
                        "mock": "366173301"
                    },
                    "position": {
                        "description": "position / place",
                        "mock": "4"
                    }
                }
            },
            "botRank": {
                "__type__": "discordEmbed",
                "title": "Sorry",
                "description": "I'm not really into collecting XP.\nMaybe try a real `user`"
            }
        }
    },
    "button": {
        "__type__": "collection",
        "_application": {
            "__type__": "collection",
            "threadTitle": {
                "__type__": "collection",
                "openContributor": {
                    "__type__": "string",
                    "string": "{memberName} as Open Contributor?"
                },
                "closedTeam": {
                    "__type__": "string",
                    "string": "{memberName} as Closed Team?"
                }
            },
            "applyMessages": {
                "__type__": "collection",
                "openContributor": {
                    "__type__": "discordEmbed",
                    "title": "Apply as Open Contributor",
                    "description": "Go ahead and tells us why you want to become a Open Contributor"
                },
                "closedTeam": {
                    "__type__": "discordEmbed",
                    "title": "Apply as Closed Team",
                    "description": "Go ahead and tell us why you want to become a part of our Closed Team"
                }
            },
            "applicationTheadCreated": {
                "__type__": "discordEmbed",
                "title": "Application Thread Created",
                "description": "A new application Thread has been created for you!"
            }
        }
    },
    "autocomplete": {},
    "selectmenu": {},
    "automatic": {
        "__type__": "collection",
        "application": {
            "__type__": "collection",
            "buttonClosedTeam": {
                "__type__": "string",
                "string": "Apply as Closed Team"
            },
            "buttonOpenContributor": {
                "__type__": "string",
                "string": "Apply as Open Contributor"
            },
            "channelMessage": {
                "__type__": "discordEmbed",
                "__variables__": {
                    "teamId": {
                        "description": "Id of the team role",
                        "mock": "13131888319"
                    }
                },
                "title": "Application Channel",
                "description": "This is where you can start your application process.\n\nYou now have the opportunity to become a part of our <@&{teamId}>.\nClick the button below to create a new thread.\nWe're excited to have you join CodeZero.\n\nIf you already have an active application thread for your Closed Team / Open Contributor, please use that to continue your application.\n\nCodeZero"
            }
        }
    }
}